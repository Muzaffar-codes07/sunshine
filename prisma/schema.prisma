generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Platform foundation only. Domain models must follow docs/architecture/data-model.md.
// Creating this table does NOT implement authentication or authorization.
enum StaffRole {
  ADMIN
  SALES
  WAREHOUSE
  TECHNICIAN
  SUPPORT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  ownedEnquiries Enquiry[]
  stockDocuments StockDocument[]
  stockMovements StockMovement[]
  commands       Command[]
  surveysAssigned Survey[] @relation("SurveyTechnician")
  surveysDecided  Survey[] @relation("SurveyDecision")

  @@map("users")
}

// Sales (D2). Value ranges are enforced by CHECK constraints in the migration SQL,
// because Prisma cannot express them.
enum EnquirySource {
  WEB
  PHONE
  WHATSAPP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

enum SystemType {
  ON_GRID
  OFF_GRID
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // Normalized 10-digit Indian mobile number; one customer record per phone.
  phone       String   @unique
  email       String?
  addressLine String
  city        String
  pincode     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  enquiries Enquiry[]

  @@map("customers")
}

model Enquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  customerId          String        @db.Uuid
  source              EnquirySource
  status              EnquiryStatus @default(NEW)
  // Contact and site as submitted with this enquiry; the customer record stays canonical.
  contactName         String
  contactEmail        String?
  siteAddressLine     String
  siteCity            String
  sitePincode         String
  requestedCapacityKw Int
  systemType          SystemType?
  subsidyInterest     Boolean       @default(false)
  message             String?
  // Qualification facts recorded on the first call (PDF: shadow-free roof area, monthly bill, grid suitability).
  shadowFreeRoofAreaSqm Decimal?    @db.Decimal(8, 2)
  monthlyBillInr        Decimal?    @db.Decimal(14, 2)
  gridConnectionSuitable Boolean?
  ownerId             String?       @db.Uuid
  nextFollowUpAt      DateTime?     @db.Timestamptz(3)
  closedReason        String?
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the owner is only a work assignment. Removing a staff user must neither be blocked
  // by their open enquiries nor delete them; the enquiry returns to the unassigned queue.
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  surveys  Survey[]

  @@index([status, nextFollowUpAt])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([createdAt])
  @@map("enquiries")
}

enum SurveyStatus {
  SCHEDULED
  SUBMITTED
  APPROVED
  REJECTED
}

enum RoofDirection {
  N
  NE
  E
  SE
  S
  SW
  W
  NW
}

// One row per survey revision (R3–R4). A decided revision is never edited: changing the facts later means a new
// revision, so the earlier approval stays as evidence. At most one open revision per enquiry (partial unique index
// surveys_one_open_per_enquiry); a quote needs the latest revision to be APPROVED.
model Survey {
  id                String         @id @default(uuid()) @db.Uuid
  enquiryId         String         @db.Uuid
  revision          Int
  status            SurveyStatus   @default(SCHEDULED)
  technicianId      String         @db.Uuid
  scheduledFor      DateTime       @db.Timestamptz(3)
  // Site measurements, required once submitted (CHECK surveys_submitted_has_measurements).
  roofDirection     RoofDirection?
  roofTiltDeg       Decimal?       @db.Decimal(4, 1)
  cableDistanceM    Decimal?       @db.Decimal(7, 2)
  usableRoofAreaSqm Decimal?       @db.Decimal(8, 2)
  notes             String?
  submittedAt       DateTime?      @db.Timestamptz(3)
  decidedById       String?        @db.Uuid
  decidedAt         DateTime?      @db.Timestamptz(3)
  decisionReason    String?
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  enquiry    Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  // Restrict: who measured and who approved are evidence, so those users cannot be deleted from under it.
  technician User    @relation("SurveyTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  decidedBy  User?   @relation("SurveyDecision", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([enquiryId, revision])
  @@index([technicianId, status, scheduledFor])
  @@index([decidedById])
  @@map("surveys")
}

// Shared staff sessions; User is rechecked on every protected request.
model Session {
  sid String @id @db.VarChar(255)
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "staff_sessions_expire_idx")
  @@map("staff_sessions")
}

// D2 canonical catalogue: D3 stock and D4 equipment identity reference these product/manufacturer IDs.
enum ProductKind {
  HARDWARE
  SERVICE
}
enum ProductTrackingMode {
  SERIALIZED
  BULK
  NONE
}
enum UnitOfMeasure {
  PCS
  SET
  M
  JOB
}
enum ProductCategory {
  PANEL
  INVERTER
  CHARGE_CONTROLLER
  BATTERY
  MOUNTING
  WIRING_BOX
  SWITCHGEAR
  CABLE
  EARTHING
  CONNECTOR
  INSTALLATION
  OTHER
}
model Manufacturer {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  products Product[]
  @@map("manufacturers")
  units Unit[]
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  sku String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  kind ProductKind
  category ProductCategory
  trackingMode ProductTrackingMode
  unitOfMeasure UnitOfMeasure
  manufacturerId String? @db.Uuid
  unitSalePrice Decimal @db.Decimal(14, 2)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  packageItems PackageItem[]
  stockDocumentLines StockDocumentLine[]
  stockMovements StockMovement[]
  units Unit[]
  costBasis ProductCostBasis?
  installationPackages Package[] @relation("PackageInstallationService")
  @@index([active, kind])
  @@map("products")
}
model Package {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  capacityKw Int
  systemType SystemType
  revision Int @default(1)
  active Boolean @default(true)
  hardwarePrice Decimal @db.Decimal(14, 2)
  installationPrice Decimal @db.Decimal(14, 2)
  installationProductId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  installationProduct Product @relation("PackageInstallationService", fields: [installationProductId], references: [id], onDelete: Restrict)
  items PackageItem[]
  @@unique([capacityKw, systemType, revision])
  @@index([active, capacityKw, systemType])
  @@map("packages")
}
model PackageItem {
  id String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid
  productId String @db.Uuid
  position Int
  quantity Decimal @db.Decimal(12, 3)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([packageId, productId])
  @@unique([packageId, position])
  @@index([productId])
  @@map("package_items")
}

// D3: stock ledger. On-hand is never stored; it is read from the stock_on_hand view. See docs/architecture/data-model.md.
enum StockLocationKind {
  USABLE
  QUARANTINE
}
enum StockDocumentKind {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}
enum StockDocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}
enum UnitStatus {
  AVAILABLE
  RESERVED
  DISPATCHED
  DELIVERED
  INSTALLED
  QUARANTINED
  RETURNED
}
model StockLocation {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(120)
  kind StockLocationKind
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  documentsFrom StockDocument[] @relation("StockDocumentFrom")
  documentsTo StockDocument[] @relation("StockDocumentTo")
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo StockMovement[] @relation("StockMovementTo")
  @@map("stock_locations")
}
model StockDocument {
  id String @id @default(uuid()) @db.Uuid
  kind StockDocumentKind
  reference String @db.VarChar(128)
  status StockDocumentStatus @default(DRAFT)
  version Int @default(1)
  // Hash of the first accepted request: the permanent guard against reusing a reference for different goods.
  payloadHash String @db.VarChar(64)
  actorId String @db.Uuid
  fromLocationId String? @db.Uuid
  toLocationId String? @db.Uuid
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  validatedAt DateTime? @db.Timestamptz(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromLocation StockLocation? @relation("StockDocumentFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation StockLocation? @relation("StockDocumentTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines StockDocumentLine[]
  @@unique([kind, reference])
  @@index([status, kind])
  @@map("stock_documents")
}
model StockDocumentLine {
  id String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  lineNumber Int
  productId String @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(14, 2)
  zeroCostReason String? @db.VarChar(500)
  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement StockMovement?
  units Unit[]
  @@unique([documentId, lineNumber])
  @@index([productId])
  @@map("stock_document_lines")
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  // Posting order. Business time can be backdated, so it can't order a unit's movements.
  sequence BigInt @unique @default(autoincrement())
  documentLineId String @unique @db.Uuid
  productId String @db.Uuid
  fromLocationId String? @db.Uuid
  toLocationId String? @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  actorId String @db.Uuid
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  documentLine StockDocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation StockLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation StockLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  unitLinks UnitMovement[]
  @@index([productId, occurredAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("stock_movements")
}
model Unit {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  manufacturerId String @db.Uuid
  rawSerial String @db.VarChar(128)
  normalizedSerial String @db.VarChar(128)
  status UnitStatus @default(AVAILABLE)
  acquisitionCost Decimal @db.Decimal(14, 2)
  receiptLineId String @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  receiptLine StockDocumentLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  movements UnitMovement[]
  @@unique([manufacturerId, productId, normalizedSerial], map: "units_identity_key")
  @@index([normalizedSerial])
  @@index([receiptLineId])
  @@map("units")
}
model UnitMovement {
  id String @id @default(uuid()) @db.Uuid
  unitId String @db.Uuid
  movementId String @db.Uuid
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@unique([unitId, movementId])
  @@index([movementId])
  @@map("unit_movements")
}
// Moving average for bulk stock only. Quantity stays derived; serial units keep their exact acquisition cost.
model ProductCostBasis {
  productId String @id @db.Uuid
  averageCost Decimal @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@map("product_cost_bases")
}

// Idempotent command results (TRD decision M6). One row per actor and Idempotency-Key, claimed at the start of the
// business transaction and committed with its result, so a retry replays the recorded result instead of acting twice.
model Command {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @db.Uuid
  idempotencyKey String
  // UPPER_SNAKE_CASE business action, such as ORDER_CONFIRM; a key reused for another action is refused.
  action         String
  // SHA-256 of the canonical JSON request body; a key reused with another body is refused.
  payloadHash    String
  // The response body returned to the first request; set before the transaction commits.
  result         Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  // Restrict: the record of who issued a money or stock command is evidence.
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, idempotencyKey])
  @@map("commands")
}
