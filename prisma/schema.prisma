generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Platform foundation only. Domain models must follow docs/architecture/data-model.md.
// Creating this table does NOT implement authentication or authorization.
enum StaffRole {
  ADMIN
  SALES
  WAREHOUSE
  TECHNICIAN
  SUPPORT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  ownedEnquiries        Enquiry[]
  ownedSubsidyMilestones SubsidyMilestone[] @relation("SubsidyResponsibleOwner")

  @@map("users")
}

// Sales (D2). Value ranges are enforced by CHECK constraints in the migration SQL,
// because Prisma cannot express them.
enum EnquirySource {
  WEB
  PHONE
  WHATSAPP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

enum SystemType {
  ON_GRID
  OFF_GRID
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // Normalized 10-digit Indian mobile number; one customer record per phone.
  phone       String   @unique
  email       String?
  addressLine String
  city        String
  pincode     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  enquiries Enquiry[]
  serviceTickets ServiceTicket[] @relation("CustomerServiceTickets")

  @@map("customers")
}

model Enquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  customerId          String        @db.Uuid
  source              EnquirySource
  status              EnquiryStatus @default(NEW)
  // Contact and site as submitted with this enquiry; the customer record stays canonical.
  contactName         String
  contactEmail        String?
  siteAddressLine     String
  siteCity            String
  sitePincode         String
  requestedCapacityKw Int
  systemType          SystemType?
  subsidyInterest     Boolean       @default(false)
  message             String?
  // Qualification facts recorded on the first call (PDF: shadow-free roof area, monthly bill, grid suitability).
  shadowFreeRoofAreaSqm Decimal?    @db.Decimal(8, 2)
  monthlyBillInr        Decimal?    @db.Decimal(14, 2)
  gridConnectionSuitable Boolean?
  ownerId             String?       @db.Uuid
  nextFollowUpAt      DateTime?     @db.Timestamptz(3)
  closedReason        String?
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the owner is only a work assignment. Removing a staff user must neither be blocked
  // by their open enquiries nor delete them; the enquiry returns to the unassigned queue.
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, nextFollowUpAt])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([createdAt])
  @@map("enquiries")
}

// Shared staff sessions; User is rechecked on every protected request.
model Session {
  sid String @id @db.VarChar(255)
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "staff_sessions_expire_idx")
  @@map("staff_sessions")
}

// D2 canonical catalogue: D3 stock and D4 equipment identity reference these product/manufacturer IDs.
enum ProductKind {
  HARDWARE
  SERVICE
}
enum ProductTrackingMode {
  SERIALIZED
  BULK
  NONE
}
enum UnitOfMeasure {
  PCS
  SET
  M
  JOB
}
enum ProductCategory {
  PANEL
  INVERTER
  CHARGE_CONTROLLER
  BATTERY
  MOUNTING
  WIRING_BOX
  SWITCHGEAR
  CABLE
  EARTHING
  CONNECTOR
  INSTALLATION
  OTHER
}
model Manufacturer {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  products Product[]
  @@map("manufacturers")
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  sku String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  kind ProductKind
  category ProductCategory
  trackingMode ProductTrackingMode
  unitOfMeasure UnitOfMeasure
  manufacturerId String? @db.Uuid
  unitSalePrice Decimal @db.Decimal(14, 2)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  packageItems PackageItem[]
  installationPackages Package[] @relation("PackageInstallationService")
  @@index([active, kind])
  @@map("products")
}
model Package {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  capacityKw Int
  systemType SystemType
  revision Int @default(1)
  active Boolean @default(true)
  hardwarePrice Decimal @db.Decimal(14, 2)
  installationPrice Decimal @db.Decimal(14, 2)
  installationProductId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  installationProduct Product @relation("PackageInstallationService", fields: [installationProductId], references: [id], onDelete: Restrict)
  items PackageItem[]
  @@unique([capacityKw, systemType, revision])
  @@index([active, capacityKw, systemType])
  @@map("packages")
}
model PackageItem {
  id String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid
  productId String @db.Uuid
  position Int
  quantity Decimal @db.Decimal(12, 3)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([packageId, productId])
  @@unique([packageId, position])
  @@index([productId])
  @@map("package_items")
}

// D4: warranty, service, cost ledger and subsidy projections (Task 1.2).
// Schema preparation only: Job, Unit and File have not landed on this branch.
// Their UUID references below MUST become explicit Restrict relations before
// a D3-coordinated migration. See docs/architecture/d4-schema-handoff.md.

enum TicketStatus {
  OPEN
  ASSESSED
  IN_PROGRESS
  AWAITING_CUSTOMER_CONFIRMATION
  CLOSED
}

enum TicketLineType {
  PART
  LABOUR
}

enum ConfirmationChannel {
  PHONE
  WHATSAPP
  IN_PERSON
}

enum CostType {
  MATERIAL_DISPATCH
  INSTALLATION_LABOUR
  SERVICE_LABOUR
  REPAIR_PARTS
}

enum SubsidyMilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
}

model Warranty {
  id             String   @id @default(uuid()) @db.Uuid
  unitId         String   @unique @db.Uuid
  // IST calendar interval [startDate, expiryDate), not UTC occurrence times.
  startDate      DateTime @db.Date
  expiryDate     DateTime @db.Date
  policyName     String
  policyRevision String
  scope          String
  durationMonths Int
  // False voids coverage; ACTIVE/EXPIRED otherwise derive from the dates.
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([active, expiryDate])
  @@map("warranties")
}

// Immutable posted ledger entries; corrections will use reversal entries.
model CostEntry {
  id             String   @id @default(uuid()) @db.Uuid
  uniqueSourceId String
  jobId          String   @db.Uuid
  costType       CostType
  amount         Decimal  @db.Decimal(14, 2)
  description    String
  postedAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([uniqueSourceId, costType])
  @@index([jobId, postedAt])
  @@index([postedAt])
  @@map("cost_entries")
}

model ServiceTicket {
  id                  String               @id @default(uuid()) @db.Uuid
  ticketNumber        String               @unique
  customerId          String               @db.Uuid
  unitId              String               @db.Uuid
  jobId               String               @db.Uuid
  status              TicketStatus         @default(OPEN)
  faultDescription    String
  assessmentSnapshot  Json?
  // Immutable Task 3.1 source hash and billing result, saved with costs/invoice.
  billingSnapshot     Json?
  resolutionDetails   String?
  resolvedAt          DateTime?            @db.Timestamptz(3)
  // Customer's recorded name, mapped from CustomerConfirmation.confirmerName.
  confirmedBy         String?
  confirmationChannel ConfirmationChannel?
  confirmedAt         DateTime?            @db.Timestamptz(3)
  confirmationNotes   String?
  closedAt            DateTime?            @db.Timestamptz(3)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  customer Customer     @relation("CustomerServiceTickets", fields: [customerId], references: [id], onDelete: Restrict)
  lines    TicketLine[] @relation("ServiceTicketLines")

  @@index([customerId])
  @@index([unitId, status])
  @@index([jobId, status])
  @@index([status, createdAt])
  @@map("service_tickets")
}

model TicketLine {
  id                 String         @id @default(uuid()) @db.Uuid
  ticketId           String         @db.Uuid
  lineType           TicketLineType
  description        String
  quantity           Decimal        @db.Decimal(12, 3)
  unitCost           Decimal        @db.Decimal(14, 2)
  totalCost          Decimal        @db.Decimal(14, 2)
  billableToCustomer Boolean
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  ticket ServiceTicket @relation("ServiceTicketLines", fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_lines")
}

model SubsidyMilestone {
  id             String                 @id @default(uuid()) @db.Uuid
  jobId          String                 @db.Uuid
  stage          String
  status         SubsidyMilestoneStatus @default(PENDING)
  submissionDate DateTime?              @db.Timestamptz(3)
  approvalDate   DateTime?              @db.Timestamptz(3)
  amount         Decimal                @db.Decimal(14, 2)
  evidenceFileId String?                @db.Uuid
  pendingDocuments   String[]           @default([])
  responsibleOwnerId String?             @db.Uuid
  responsibleOwner   User?               @relation("SubsidyResponsibleOwner", fields: [responsibleOwnerId], references: [id], onDelete: Restrict)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([jobId, status])
  @@index([status, stage])
  @@index([evidenceFileId])
  @@index([responsibleOwnerId, status])
  @@map("subsidy_milestones")
}
