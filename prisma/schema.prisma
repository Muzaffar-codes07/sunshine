generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Platform foundation only. Domain models must follow docs/architecture/data-model.md.
// Creating this table does NOT implement authentication or authorization.
enum StaffRole {
  ADMIN
  SALES
  WAREHOUSE
  TECHNICIAN
  SUPPORT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  ownedSubsidyMilestones SubsidyMilestone[] @relation("SubsidyResponsibleOwner")
  uploadedFiles File[]
  ownedEnquiries Enquiry[]
  stockDocuments StockDocument[] @relation("StockDocumentActor")
  stockDocumentsValidated StockDocument[] @relation("StockDocumentValidator")
  stockMovements StockMovement[]
  allocations Allocation[]
  dispatchesPosted Dispatch[] @relation("DispatchPostedBy")
  dispatchesDelivered Dispatch[] @relation("DispatchDeliveredBy")
  allocationsReleased Allocation[] @relation("AllocationReleaseActor")
  dispatchesCreated Dispatch[]
  dispatchScans DispatchScan[]
  jobAssignments JobAssignment[] @relation("JobAssignmentTechnician")
  jobAssignmentsMade JobAssignment[] @relation("JobAssignmentMadeBy")
  jobsStarted Job[] @relation("JobStartedBy")
  jobsCompleted Job[] @relation("JobCompletedBy")
  installationTimeRecords InstallationTimeRecord[] @relation("InstallationTimeTechnician")
  installationTimeRecorded InstallationTimeRecord[] @relation("InstallationTimeRecordedBy")
  commands       Command[]
  surveysAssigned Survey[] @relation("SurveyTechnician")
  surveysDecided  Survey[] @relation("SurveyDecision")
  quotesCreated Quote[] @relation("QuoteCreator")
  quotesSent Quote[] @relation("QuoteSender")
  quotesDecided Quote[] @relation("QuoteDecider")
  ordersConfirmed Order[] @relation("OrderConfirmer")
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  technicianRates TechnicianRateRevision[] @relation("RateTechnician")
  technicianRatesCreated TechnicianRateRevision[] @relation("RateCreator")
  labourApproved InstallationLabourApproval[] @relation("LabourApprover")

  @@map("users")
}

// Sales (D2). Value ranges are enforced by CHECK constraints in the migration SQL,
// because Prisma cannot express them.
enum EnquirySource {
  WEB
  PHONE
  WHATSAPP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

enum SystemType {
  ON_GRID
  OFF_GRID
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // Normalized 10-digit Indian mobile number; one customer record per phone.
  phone       String   @unique
  email       String?
  addressLine String
  city        String
  pincode     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  enquiries Enquiry[]
  serviceTickets ServiceTicket[] @relation("CustomerServiceTickets")

  quotes Quote[]
  orders Order[]
  invoices Invoice[]
  @@map("customers")
}

model Enquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  customerId          String        @db.Uuid
  source              EnquirySource
  status              EnquiryStatus @default(NEW)
  // Contact and site as submitted with this enquiry; the customer record stays canonical.
  contactName         String
  contactEmail        String?
  siteAddressLine     String
  siteCity            String
  sitePincode         String
  requestedCapacityKw Int
  systemType          SystemType?
  subsidyInterest     Boolean       @default(false)
  message             String?
  // Qualification facts recorded on the first call (PDF: shadow-free roof area, monthly bill, grid suitability).
  shadowFreeRoofAreaSqm Decimal?    @db.Decimal(8, 2)
  monthlyBillInr        Decimal?    @db.Decimal(14, 2)
  gridConnectionSuitable Boolean?
  ownerId             String?       @db.Uuid
  nextFollowUpAt      DateTime?     @db.Timestamptz(3)
  closedReason        String?
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the owner is only a work assignment. Removing a staff user must neither be blocked
  // by their open enquiries nor delete them; the enquiry returns to the unassigned queue.
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  surveys  Survey[]
  order    Order?

  @@index([status, nextFollowUpAt])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([createdAt])
  quotes Quote[]
  @@map("enquiries")
}

enum SurveyStatus {
  SCHEDULED
  SUBMITTED
  APPROVED
  REJECTED
}

enum RoofDirection {
  N
  NE
  E
  SE
  S
  SW
  W
  NW
}

// One row per survey revision (R3–R4). A decided revision is never edited: changing the facts later means a new
// revision, so the earlier approval stays as evidence. At most one open revision per enquiry (partial unique index
// surveys_one_open_per_enquiry); a quote needs the latest revision to be APPROVED.
model Survey {
  id                String         @id @default(uuid()) @db.Uuid
  enquiryId         String         @db.Uuid
  revision          Int
  status            SurveyStatus   @default(SCHEDULED)
  technicianId      String         @db.Uuid
  scheduledFor      DateTime       @db.Timestamptz(3)
  // Site measurements, required once submitted (CHECK surveys_submitted_has_measurements).
  roofDirection     RoofDirection?
  roofTiltDeg       Decimal?       @db.Decimal(4, 1)
  cableDistanceM    Decimal?       @db.Decimal(7, 2)
  usableRoofAreaSqm Decimal?       @db.Decimal(8, 2)
  notes             String?
  submittedAt       DateTime?      @db.Timestamptz(3)
  decidedById       String?        @db.Uuid
  decidedAt         DateTime?      @db.Timestamptz(3)
  decisionReason    String?
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  enquiry    Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  // Restrict: who measured and who approved are evidence, so those users cannot be deleted from under it.
  technician User    @relation("SurveyTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  decidedBy  User?   @relation("SurveyDecision", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([enquiryId, revision])
  @@index([technicianId, status, scheduledFor])
  @@index([decidedById])
  quotes Quote[]
  @@map("surveys")
}

// Shared staff sessions; User is rechecked on every protected request.
model Session {
  sid String @id @db.VarChar(255)
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "staff_sessions_expire_idx")
  @@map("staff_sessions")
}

// D2 canonical catalogue: D3 stock and D4 equipment identity reference these product/manufacturer IDs.
enum ProductKind {
  HARDWARE
  SERVICE
}
enum ProductTrackingMode {
  SERIALIZED
  BULK
  NONE
}
enum UnitOfMeasure {
  PCS
  SET
  M
  JOB
}
enum ProductCategory {
  PANEL
  INVERTER
  CHARGE_CONTROLLER
  BATTERY
  MOUNTING
  WIRING_BOX
  SWITCHGEAR
  CABLE
  EARTHING
  CONNECTOR
  INSTALLATION
  OTHER
}
model Manufacturer {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  products Product[]
  @@map("manufacturers")
  units Unit[]
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  sku String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  kind ProductKind
  category ProductCategory
  trackingMode ProductTrackingMode
  unitOfMeasure UnitOfMeasure
  manufacturerId String? @db.Uuid
  unitSalePrice Decimal @db.Decimal(14, 2)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  packageItems PackageItem[]
  stockDocumentLines StockDocumentLine[]
  stockMovements StockMovement[]
  units Unit[]
  allocations Allocation[]
  costBasis ProductCostBasis?
  warrantyPolicy ProductWarrantyPolicy?
  installationPackages Package[] @relation("PackageInstallationService")
  @@index([active, kind])
  quoteLines QuoteLine[]
  packingRequirements PackingRequirement[]
  @@map("products")
}
model Package {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  capacityKw Int
  systemType SystemType
  revision Int @default(1)
  active Boolean @default(true)
  hardwarePrice Decimal @db.Decimal(14, 2)
  installationPrice Decimal @db.Decimal(14, 2)
  installationProductId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  installationProduct Product @relation("PackageInstallationService", fields: [installationProductId], references: [id], onDelete: Restrict)
  items PackageItem[]
  @@unique([capacityKw, systemType, revision])
  @@index([active, capacityKw, systemType])
  quotes Quote[]
  @@map("packages")
}
model PackageItem {
  id String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid
  productId String @db.Uuid
  position Int
  quantity Decimal @db.Decimal(12, 3)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([packageId, productId])
  @@unique([packageId, position])
  @@index([productId])
  @@map("package_items")
}

// D4: warranty, service, cost ledger and subsidy projections (Task 1.2).
// Unit/Job/File relations follow the reviewed D2/D3 handoffs. The initial D4
// migration at 20261031260000 follows Files 20261031255000.
// See docs/architecture/d4-schema-handoff.md.

enum TicketStatus {
  OPEN
  ASSESSED
  IN_PROGRESS
  AWAITING_CUSTOMER_CONFIRMATION
  CLOSED
}

enum TicketLineType {
  PART
  LABOUR
}

enum ConfirmationChannel {
  PHONE
  WHATSAPP
  IN_PERSON
}

enum CostType {
  MATERIAL_DISPATCH
  INSTALLATION_LABOUR
  SERVICE_LABOUR
  REPAIR_PARTS
}

enum SubsidyMilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
}

// What a product's warranty promises today. A quote freezes these terms, so editing a row never changes cover already sold.
model ProductWarrantyPolicy {
  productId      String   @id @db.Uuid
  policyName     String   @db.VarChar(200)
  revision       String   @db.VarChar(100)
  scope          String   @db.VarChar(2000)
  durationMonths Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@map("product_warranty_policies")
}

model Warranty {
  id             String   @id @default(uuid()) @db.Uuid
  unitId         String   @unique @db.Uuid
  // IST calendar interval [startDate, expiryDate), not UTC occurrence times.
  startDate      DateTime @db.Date
  expiryDate     DateTime @db.Date
  policyName     String
  policyRevision String
  scope          String
  durationMonths Int
  // False voids coverage; ACTIVE/EXPIRED otherwise derive from the dates.
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  unit Unit @relation("UnitWarranty", fields: [unitId], references: [id], onDelete: Restrict)
  @@index([active, expiryDate])
  @@map("warranties")
}

// Immutable ledger: one full signed reversal per original, then a new source for corrections.
model CostEntry {
  id             String   @id @default(uuid()) @db.Uuid
  uniqueSourceId String
  jobId          String   @db.Uuid
  costType       CostType
  amount         Decimal  @db.Decimal(14, 2)
  description    String
  occurredAt     DateTime @db.Timestamptz(3)
  job            Job      @relation("JobCosts", fields: [jobId], references: [id], onDelete: Restrict)
  reversalOfId   String?  @unique @db.Uuid
  reversalOf     CostEntry? @relation("CostReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       CostEntry? @relation("CostReversal")
  postedAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  installationApproval InstallationLabourApproval?

  @@unique([uniqueSourceId, costType])
  @@index([jobId, occurredAt])
  @@index([occurredAt])
  @@map("cost_entries")
}

model ServiceTicket {
  id                  String               @id @default(uuid()) @db.Uuid
  ticketNumber        String               @unique
  customerId          String               @db.Uuid
  unitId              String               @db.Uuid
  jobId               String               @db.Uuid
  status              TicketStatus         @default(OPEN)
  faultDescription    String
  assessmentSnapshot  Json?
  // Immutable Task 3.1 source hash and billing result, saved with costs/invoice.
  billingSnapshot     Json?
  // Original unitId stays immutable; these links and result preserve swap history.
  replacedUnitId      String?              @db.Uuid
  newUnitId           String?              @db.Uuid
  replacementSnapshot Json?
  resolutionDetails   String?
  resolvedAt          DateTime?            @db.Timestamptz(3)
  // Customer's recorded name, mapped from CustomerConfirmation.confirmerName.
  confirmedBy         String?
  confirmationChannel ConfirmationChannel?
  confirmedAt         DateTime?            @db.Timestamptz(3)
  confirmationNotes   String?
  closedAt            DateTime?            @db.Timestamptz(3)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  customer Customer     @relation("CustomerServiceTickets", fields: [customerId], references: [id], onDelete: Restrict)
  lines    TicketLine[] @relation("ServiceTicketLines")
  unit Unit @relation("UnitServiceTickets", fields: [unitId], references: [id], onDelete: Restrict)
  job Job @relation("JobServiceTickets", fields: [jobId], references: [id], onDelete: Restrict)
  replacedUnit Unit? @relation("ReplacedUnitTickets", fields: [replacedUnitId], references: [id], onDelete: Restrict)
  newUnit Unit? @relation("NewUnitTickets", fields: [newUnitId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([unitId, status])
  @@index([jobId, status])
  @@index([replacedUnitId])
  @@index([newUnitId])
  @@index([status, createdAt])
  @@map("service_tickets")
}

model TicketLine {
  id                 String         @id @default(uuid()) @db.Uuid
  ticketId           String         @db.Uuid
  lineType           TicketLineType
  description        String
  quantity           Decimal        @db.Decimal(12, 3)
  unitCost           Decimal        @db.Decimal(14, 2)
  totalCost          Decimal        @db.Decimal(14, 2)
  billableToCustomer Boolean
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  ticket ServiceTicket @relation("ServiceTicketLines", fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_lines")
}

model SubsidyMilestone {
  id             String                 @id @default(uuid()) @db.Uuid
  jobId          String                 @db.Uuid
  stage          String
  status         SubsidyMilestoneStatus @default(PENDING)
  submissionDate DateTime?              @db.Timestamptz(3)
  approvalDate   DateTime?              @db.Timestamptz(3)
  amount         Decimal                @db.Decimal(14, 2)
  evidenceFileId String?                @db.Uuid
  evidenceFile   File?                  @relation("SubsidyEvidence", fields: [evidenceFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pendingDocuments   String[]           @default([])
  responsibleOwnerId String?             @db.Uuid
  responsibleOwner   User?               @relation("SubsidyResponsibleOwner", fields: [responsibleOwnerId], references: [id], onDelete: Restrict)
  job            Job                    @relation("JobSubsidies", fields: [jobId], references: [id], onDelete: Restrict)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([jobId, status])
  @@index([status, stage])
  @@index([evidenceFileId])
  @@index([responsibleOwnerId, status])
  @@map("subsidy_milestones")
}

// D3: stock ledger. On-hand is never stored; it is read from the stock_on_hand view. See docs/architecture/data-model.md.
enum StockLocationKind {
  USABLE
  QUARANTINE
}
enum StockDocumentKind {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}
enum StockDocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}
enum UnitStatus {
  AVAILABLE
  RESERVED
  DISPATCHED
  DELIVERED
  INSTALLED
  QUARANTINED
  RETURNED
}
model StockLocation {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(120)
  kind StockLocationKind
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  documentsFrom StockDocument[] @relation("StockDocumentFrom")
  documentsTo StockDocument[] @relation("StockDocumentTo")
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo StockMovement[] @relation("StockMovementTo")
  allocations Allocation[]
  @@map("stock_locations")
}
model StockDocument {
  id String @id @default(uuid()) @db.Uuid
  kind StockDocumentKind
  reference String @db.VarChar(128)
  status StockDocumentStatus @default(DRAFT)
  version Int @default(1)
  // Hash of the first accepted request: the permanent guard against reusing a reference for different goods.
  payloadHash String @db.VarChar(64)
  actorId String @db.Uuid
  fromLocationId String? @db.Uuid
  toLocationId String? @db.Uuid
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  validatedAt DateTime? @db.Timestamptz(3)
  // Who posted it, when that differs from who drafted it. Its movements carry this actor.
  validatedById String? @db.Uuid
  actor User @relation("StockDocumentActor", fields: [actorId], references: [id], onDelete: Restrict)
  validatedBy User? @relation("StockDocumentValidator", fields: [validatedById], references: [id], onDelete: Restrict)
  fromLocation StockLocation? @relation("StockDocumentFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation StockLocation? @relation("StockDocumentTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines StockDocumentLine[]
  dispatch Dispatch?
  @@unique([kind, reference])
  @@index([status, kind])
  @@map("stock_documents")
}
model StockDocumentLine {
  id String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  lineNumber Int
  productId String @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(14, 2)
  zeroCostReason String? @db.VarChar(500)
  // Count lines only. Measured under the lock at validation; quantity is then the difference, and zero when they match.
  countedQuantity Decimal? @db.Decimal(12, 3)
  measuredQuantity Decimal? @db.Decimal(12, 3)
  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement StockMovement?
  units Unit[]
  plannedUnits StockDocumentLineUnit[]
  @@unique([documentId, lineNumber])
  @@index([productId])
  @@map("stock_document_lines")
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  // Posting order. Business time can be backdated, so it can't order a unit's movements.
  sequence BigInt @unique @default(autoincrement())
  documentLineId String @unique @db.Uuid
  productId String @db.Uuid
  fromLocationId String? @db.Uuid
  toLocationId String? @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  actorId String @db.Uuid
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  documentLine StockDocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation StockLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation StockLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  unitLinks UnitMovement[]
  @@index([productId, occurredAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("stock_movements")
}
model Unit {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  manufacturerId String @db.Uuid
  rawSerial String @db.VarChar(128)
  normalizedSerial String @db.VarChar(128)
  status UnitStatus @default(AVAILABLE)
  acquisitionCost Decimal @db.Decimal(14, 2)
  receiptLineId String @db.Uuid
  // Historical predecessor only; actual ticket/stock/warranty replacement is a separate command.
  replacesUnitId String? @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  receiptLine StockDocumentLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  movements UnitMovement[]
  plannedLines StockDocumentLineUnit[]
  allocations Allocation[]
  warranty Warranty? @relation("UnitWarranty")
  serviceTickets ServiceTicket[] @relation("UnitServiceTickets")
  replacementTickets ServiceTicket[] @relation("ReplacedUnitTickets")
  newUnitTickets ServiceTicket[] @relation("NewUnitTickets")
  replacesUnit Unit? @relation("UnitReplacementLineage", fields: [replacesUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementUnits Unit[] @relation("UnitReplacementLineage")
  @@unique([manufacturerId, productId, normalizedSerial], map: "units_identity_key")
  @@index([normalizedSerial])
  @@index([receiptLineId])
  @@index([replacesUnitId])
  @@map("units")
}
// The serial units a draft line will move. Checked and locked at validation, frozen with the document.
model StockDocumentLineUnit {
  id String @id @default(uuid()) @db.Uuid
  lineId String @db.Uuid
  unitId String @db.Uuid
  line StockDocumentLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  @@unique([lineId, unitId])
  @@index([unitId])
  @@map("stock_document_line_units")
}
model UnitMovement {
  id String @id @default(uuid()) @db.Uuid
  unitId String @db.Uuid
  movementId String @db.Uuid
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@unique([unitId, movementId])
  @@index([movementId])
  @@map("unit_movements")
}
// Moving average for bulk stock only. Quantity stays derived; serial units keep their exact acquisition cost.
model ProductCostBasis {
  productId String @id @db.Uuid
  averageCost Decimal @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@map("product_cost_bases")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}
enum QuoteLineKind {
  PACKAGE
  COMPONENT
  SERVICE
}
enum QuoteSentChannel {
  EMAIL
  WHATSAPP
  PRINT
  OTHER
}
enum QuoteDecisionChannel {
  IN_PERSON
  PHONE
  EMAIL
  WHATSAPP
}
enum QuotePolicyStatus {
  CONFIGURED
  UNCONFIGURED
  NOT_APPLICABLE
}

// Content is frozen at creation. Edits create a successor; only status/evidence changes in place.
model Quote {
  id                 String @id @default(uuid()) @db.Uuid
  enquiryId          String @db.Uuid
  surveyId           String @db.Uuid
  packageId          String @db.Uuid
  customerId         String @db.Uuid
  revision           Int
  version            Int @default(1)
  status             QuoteStatus @default(DRAFT)
  supersedesQuoteId  String? @unique @db.Uuid
  revisionReason     String?
  customerSnapshot   Json
  packageSnapshot    Json
  hardwarePrice      Decimal @db.Decimal(14, 2)
  installationPrice  Decimal @db.Decimal(14, 2)
  totalPrice         Decimal @db.Decimal(14, 2)
  createdById        String @db.Uuid
  sentAt             DateTime? @db.Timestamptz(3)
  sentChannel        QuoteSentChannel?
  sentById           String? @db.Uuid
  decidedAt          DateTime? @db.Timestamptz(3)
  decidedById        String? @db.Uuid
  acceptedByName     String? @db.VarChar(120)
  decisionChannel    QuoteDecisionChannel?
  decisionReference  String? @db.VarChar(500)
  decisionReason     String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  enquiry      Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  survey       Survey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  package      Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sentBy       User? @relation("QuoteSender", fields: [sentById], references: [id], onDelete: Restrict)
  decidedBy    User? @relation("QuoteDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  supersedes   Quote? @relation("QuoteRevision", fields: [supersedesQuoteId], references: [id], onDelete: Restrict)
  supersededBy Quote? @relation("QuoteRevision")
  lines        QuoteLine[]
  order        Order?

  @@unique([enquiryId, revision])
  @@index([customerId, status])
  @@index([surveyId])
  @@index([packageId])
  @@index([createdById])
  @@index([sentById])
  @@index([decidedById])
  @@map("quotes")
}

model QuoteLine {
  id                       String @id @default(uuid()) @db.Uuid
  quoteId                  String @db.Uuid
  position                 Int
  kind                     QuoteLineKind
  description              String @db.VarChar(200)
  quantity                 Decimal @db.Decimal(12, 3)
  unitPrice                Decimal @db.Decimal(14, 2)
  lineTotal                Decimal @db.Decimal(14, 2)
  productId                String? @db.Uuid
  productSnapshot          Json?
  policyStatus             QuotePolicyStatus
  warrantyPolicySnapshot   Json?

  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  packingRequirement PackingRequirement?
  invoiceLines InvoiceLine[]
  allocations Allocation[]

  @@unique([quoteId, position])
  @@index([productId])
  @@map("quote_lines")
}

// Idempotent command results (TRD decision M6). One row per actor and Idempotency-Key, claimed at the start of the
// business transaction and committed with its result, so a retry replays the recorded result instead of acting twice.
model Command {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @db.Uuid
  idempotencyKey String
  // UPPER_SNAKE_CASE business action, such as ORDER_CONFIRM; a key reused for another action is refused.
  action         String
  // SHA-256 of the canonical JSON request body; a key reused with another body is refused.
  payloadHash    String
  // The response body returned to the first request; set before the transaction commits.
  result         Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  // Restrict: the record of who issued a money or stock command is evidence.
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, idempotencyKey])
  @@map("commands")
}

// Orders and invoicing (D2, C5: R7, R8, R21). Confirmation turns the latest accepted quote into one order, its
// packing requirements (one per COMPONENT quote line) and one sales invoice, in one idempotent transaction.
// One order per enquiry as well as per quote, so a later quote revision can never become a second sale.
model Order {
  id            String   @id @default(uuid()) @db.Uuid
  number        Int      @unique @default(autoincrement())
  quoteId       String   @unique @db.Uuid
  enquiryId     String   @unique @db.Uuid
  customerId    String   @db.Uuid
  // Set by D3's job helper in the confirming transaction. Null only on a row that hasn't reached that step.
  jobId         String?  @unique @db.Uuid
  confirmedById String   @db.Uuid
  confirmedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Restrict throughout: an order is a sale record and its sources are evidence.
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  confirmedBy User     @relation("OrderConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  // The composite key means an order can only point at its own job.
  job         Job?     @relation("OrderJob", fields: [id, jobId], references: [orderId, id], onDelete: Restrict, onUpdate: Restrict)
  ownJob      Job?     @relation("JobOrder")
  packing     PackingRequirement[]
  invoices    Invoice[]
  dispatch    Dispatch?

  @@unique([id, jobId])
  @@index([customerId])
  @@index([confirmedById])
  @@map("orders")
}

// What the warehouse must pack: the accepted quote's COMPONENT lines, frozen at confirmation. D3 allocates stock
// against quoteLineId; component prices are zero because the package line already charges the hardware.
model PackingRequirement {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  quoteLineId String  @unique @db.Uuid
  productId   String  @db.Uuid
  quantity    Decimal @db.Decimal(12, 3)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quoteLine QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("packing_requirements")
}

enum InvoiceSourceType {
  ORDER
  TICKET
}

enum InvoiceKind {
  SALE
  REPAIR
}

enum InvoiceStatus {
  POSTED
  PART_PAID
  PAID
}

// Posted invoices are never edited except for the paid amount, which only the receipt helper changes.
// Unique (sourceType, sourceId, kind) makes posting idempotent: one sales invoice per order (TRD section 5).
model Invoice {
  id          String            @id @default(uuid()) @db.Uuid
  number      Int               @unique @default(autoincrement())
  sourceType  InvoiceSourceType
  sourceId    String            @db.Uuid
  kind        InvoiceKind
  orderId     String?           @db.Uuid
  customerId  String            @db.Uuid
  status      InvoiceStatus     @default(POSTED)
  // Private canonical repair posting facts; sales invoices retain null.
  sourceSnapshot Json?
  subtotal    Decimal           @db.Decimal(14, 2)
  // Pre-tax management example: tax is not configured, so it is zero with an explicit note (TRD money rules).
  taxAmount   Decimal           @default(0) @db.Decimal(14, 2)
  taxNote     String            @db.VarChar(200)
  total       Decimal           @db.Decimal(14, 2)
  paidAmount  Decimal           @default(0) @db.Decimal(14, 2)
  version     Int               @default(1)
  postedAt    DateTime          @default(now()) @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  order    Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([sourceType, sourceId, kind])
  @@index([orderId])
  @@index([customerId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  position    Int
  description String  @db.VarChar(200)
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  quoteLineId String? @db.Uuid

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  quoteLine QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@index([quoteLineId])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum PaymentKind {
  ADVANCE
  PARTIAL
  FINAL
}

// A receipt staff record after money arrives outside the app (no gateway). The external reference is unique per
// method, so the same bank or UPI reference cannot be counted twice (TRD: Payment, external reference, RECEIPT).
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  reference    String        @db.VarChar(120)
  kind         PaymentKind
  receivedAt   DateTime      @db.Timestamptz(3)
  recordedById String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([method, reference])
  @@index([invoiceId])
  @@index([recordedById])
  @@map("payments")
}

// D3: jobs. One per confirmed order, created in the confirming transaction. Customer, capacity and system type stay
// on the order and its accepted quote, read through this relation instead of being copied here.
enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  AWAITING_ACCEPTANCE
  COMPLETED
}
model Job {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @unique @db.Uuid
  status    JobStatus @default(SCHEDULED)
  version   Int       @default(1)
  scheduledStart DateTime? @db.Timestamptz(3)
  scheduledFinish DateTime? @db.Timestamptz(3)
  // Evidence from the field. It is frozen once the job is COMPLETED.
  startedAt DateTime? @db.Timestamptz(3)
  startedById String? @db.Uuid
  finishedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  completedById String? @db.Uuid
  installedCapacityKw Int?
  signatureFileId String? @unique @db.Uuid
  signerName String? @db.VarChar(120)
  completedChecks InstallationCheck[] @default([])
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  order     Order     @relation("JobOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  linkedBy  Order?    @relation("OrderJob")
  allocations Allocation[]
  assignments JobAssignment[]
  costs CostEntry[] @relation("JobCosts")
  serviceTickets ServiceTicket[] @relation("JobServiceTickets")
  subsidyMilestones SubsidyMilestone[] @relation("JobSubsidies")
  startedBy User? @relation("JobStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  completedBy User? @relation("JobCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  signatureFile File? @relation("JobSignature", fields: [signatureFileId], references: [id], onDelete: Restrict)
  photos JobPhoto[]
  timeRecords InstallationTimeRecord[]

  @@unique([orderId, id])
  @@map("jobs")
}

// D3: a job's hold on stock. Only RESERVED reduces free stock, because dispatched goods have already left the ledger.
enum AllocationStatus {
  RESERVED
  DISPATCHED
  DELIVERED
  INSTALLED
  RELEASED
}
model Allocation {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  // The sold requirement. Repair parts will use a ticket line instead, once ticket lines exist.
  quoteLineId String? @db.Uuid
  productId String @db.Uuid
  unitId String? @db.Uuid
  locationId String @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  status AllocationStatus @default(RESERVED)
  version Int @default(1)
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  releasedById String? @db.Uuid
  releaseReason String? @db.VarChar(500)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quoteLine QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  releasedBy User? @relation("AllocationReleaseActor", fields: [releasedById], references: [id], onDelete: Restrict)
  scans DispatchScan[]
  @@index([jobId, status])
  @@index([productId, locationId, status])
  @@index([quoteLineId])
  @@index([unitId])
  @@index([locationId])
  @@index([actorId])
  @@index([releasedById])
  @@map("allocations")
}

// I06 draft/scans only. Posting status and stock/cost linkage are added with the actual dispatch writer.
enum DispatchStatus {
  DRAFT
  DISPATCHED
  DELIVERED
}
model Dispatch {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  createdById String @db.Uuid
  version Int @default(1)
  status DispatchStatus @default(DRAFT)
  // The issue document that took the goods out of stock.
  issueDocumentId String? @unique @db.Uuid
  dispatchedAt DateTime? @db.Timestamptz(3)
  dispatchedById String? @db.Uuid
  deliveredAt DateTime? @db.Timestamptz(3)
  deliveredById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  issueDocument StockDocument? @relation(fields: [issueDocumentId], references: [id], onDelete: Restrict)
  dispatchedBy User? @relation("DispatchPostedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  deliveredBy User? @relation("DispatchDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  scans DispatchScan[]
  @@index([createdById])
  @@map("dispatches")
}
enum ScanMethod {
  CAMERA
  SCANNER
  TYPED
}
model DispatchScan {
  id String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  allocationId String @db.Uuid
  rawValue String @db.VarChar(512)
  normalizedSerial String @db.VarChar(128)
  method ScanMethod
  actorId String @db.Uuid
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  allocation Allocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([dispatchId, allocationId, method])
  @@index([allocationId])
  @@index([actorId])
  @@map("dispatch_scans")
}

// D3: who is on a job. A removed assignment stays as history, so only rows without removedAt are active.
model JobAssignment {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  technicianId String @db.Uuid
  assignedById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  removedAt DateTime? @db.Timestamptz(3)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  technician User @relation("JobAssignmentTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  assignedBy User @relation("JobAssignmentMadeBy", fields: [assignedById], references: [id], onDelete: Restrict)
  @@index([jobId])
  @@index([technicianId, removedAt])
  @@index([assignedById])
  @@map("job_assignments")
}

enum FileContextType {
  JOB
  TICKET
}
model File {
  id String @id @default(uuid()) @db.Uuid
  storageKey String @unique @db.VarChar(36)
  originalName String @db.VarChar(150)
  mediaType String @db.VarChar(40)
  sizeBytes Int
  sha256 String @db.VarChar(64)
  uploadedById String @db.Uuid
  contextType FileContextType?
  contextId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  subsidyEvidenceMilestones SubsidyMilestone[] @relation("SubsidyEvidence")
  signedJob Job? @relation("JobSignature")
  jobPhoto JobPhoto?
  @@index([contextType, contextId])
  @@index([uploadedById, createdAt])
  @@map("files")
}

// D3: installation evidence. Rows are append-only, and a file can be evidence for one job only.
enum InstallationCheck {
  MOUNTING
  PANELS
  WIRING
  EARTHING
  POWER_GENERATION
  BATTERY
}
model JobPhoto {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  fileId String @unique @db.Uuid
  position Int
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@unique([jobId, position])
  @@map("job_photos")
}
// Labour on a job. Its id is the durable source for the labour cost (TIME_RECORD:<id>), which D4's cost writer will post.
model InstallationTimeRecord {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  technicianId String @db.Uuid
  startedAt DateTime @db.Timestamptz(3)
  finishedAt DateTime @db.Timestamptz(3)
  recordedById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  technician User @relation("InstallationTimeTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  recordedBy User @relation("InstallationTimeRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  labourApproval InstallationLabourApproval?
  @@index([jobId])
  @@index([technicianId, startedAt])
  @@index([recordedById])
  @@map("installation_time_records")
}

// Approved, append-only rate revisions. Later revisions never reprice approved work.
model TechnicianRateRevision {
  id String @id @default(uuid()) @db.Uuid
  technicianId String @db.Uuid
  hourlyRate Decimal @db.Decimal(14, 2)
  reference String @db.VarChar(500)
  createdById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  technician User @relation("RateTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  createdBy User @relation("RateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvals InstallationLabourApproval[]
  @@index([technicianId, createdAt])
  @@index([createdById])
  @@map("technician_rate_revisions")
}

// Work occurrence, frozen rate and one posted cost are committed together by ADMIN approval.
model InstallationLabourApproval {
  timeRecordId String @id @db.Uuid
  rateRevisionId String @db.Uuid
  costEntryId String @unique @db.Uuid
  elapsedMs BigInt
  hours Decimal @db.Decimal(12, 3)
  hourlyRate Decimal @db.Decimal(14, 2)
  amount Decimal @db.Decimal(14, 2)
  approvedById String @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)
  note String @db.VarChar(500)
  timeRecord InstallationTimeRecord @relation(fields: [timeRecordId], references: [id], onDelete: Restrict)
  rateRevision TechnicianRateRevision @relation(fields: [rateRevisionId], references: [id], onDelete: Restrict)
  costEntry CostEntry @relation(fields: [costEntryId], references: [id], onDelete: Restrict)
  approvedBy User @relation("LabourApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  @@index([approvedAt])
  @@index([rateRevisionId])
  @@index([approvedById])
  @@map("installation_labour_approvals")
}
