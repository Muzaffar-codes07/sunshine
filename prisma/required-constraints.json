{
  "description": "Canonical PostgreSQL 17 definitions for hand-written rules. Update with each reviewed migration; db:check verifies schema, table, kind, validity and full definition.",
  "kinds": [
    "check",
    "exclusion",
    "unique_partial_index"
  ],
  "required": [
    {
      "name": "customers_name_not_blank",
      "table": "customers",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((length(btrim(name)) >= 2))"
    },
    {
      "name": "customers_phone_format",
      "table": "customers",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((phone ~ '^[6-9][0-9]{9}$'::text))"
    },
    {
      "name": "customers_pincode_format",
      "table": "customers",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((pincode ~ '^[1-9][0-9]{5}$'::text))"
    },
    {
      "name": "enquiries_bill_nonnegative",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"monthlyBillInr\" IS NULL) OR (\"monthlyBillInr\" >= (0)::numeric)))"
    },
    {
      "name": "enquiries_capacity_range",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"requestedCapacityKw\" >= 1) AND (\"requestedCapacityKw\" <= 5)))"
    },
    {
      "name": "enquiries_closed_has_reason",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((status <> ALL (ARRAY['DISQUALIFIED'::\"EnquiryStatus\", 'ARCHIVED'::\"EnquiryStatus\"])) OR ((\"closedReason\" IS NOT NULL) AND (length(btrim(\"closedReason\")) > 0))))"
    },
    {
      "name": "enquiries_roof_area_nonnegative",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"shadowFreeRoofAreaSqm\" IS NULL) OR (\"shadowFreeRoofAreaSqm\" >= (0)::numeric)))"
    },
    {
      "name": "enquiries_site_pincode_format",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((\"sitePincode\" ~ '^[1-9][0-9]{5}$'::text))"
    },
    {
      "name": "enquiries_version_positive",
      "table": "enquiries",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((version >= 1))"
    },
    {
      "name": "manufacturers_name_not_blank",
      "table": "manufacturers",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((length(btrim((name)::text)) > 0))"
    },
    {
      "name": "products_sku_format",
      "table": "products",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((sku)::text ~ '^[A-Z0-9][A-Z0-9_-]{1,63}$'::text))"
    },
    {
      "name": "products_name_not_blank",
      "table": "products",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((length(btrim((name)::text)) > 0))"
    },
    {
      "name": "products_price_nonnegative",
      "table": "products",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"unitSalePrice\" >= (0)::numeric) AND (\"unitSalePrice\" <> 'NaN'::numeric)))"
    },
    {
      "name": "products_tracking_consistent",
      "table": "products",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((((kind = 'SERVICE'::\"ProductKind\") AND (\"trackingMode\" = 'NONE'::\"ProductTrackingMode\") AND (\"manufacturerId\" IS NULL) AND (\"unitOfMeasure\" = 'JOB'::\"UnitOfMeasure\")) OR ((kind = 'HARDWARE'::\"ProductKind\") AND (\"trackingMode\" = ANY (ARRAY['SERIALIZED'::\"ProductTrackingMode\", 'BULK'::\"ProductTrackingMode\"])) AND (\"manufacturerId\" IS NOT NULL))))"
    },
    {
      "name": "products_serialized_uom",
      "table": "products",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"trackingMode\" <> 'SERIALIZED'::\"ProductTrackingMode\") OR (\"unitOfMeasure\" = 'PCS'::\"UnitOfMeasure\")))"
    },
    {
      "name": "packages_capacity_range",
      "table": "packages",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"capacityKw\" >= 1) AND (\"capacityKw\" <= 5)))"
    },
    {
      "name": "packages_revision_positive",
      "table": "packages",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((revision >= 1))"
    },
    {
      "name": "packages_prices_nonnegative",
      "table": "packages",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((\"hardwarePrice\" >= (0)::numeric) AND (\"installationPrice\" >= (0)::numeric) AND (\"hardwarePrice\" <> 'NaN'::numeric) AND (\"installationPrice\" <> 'NaN'::numeric) AND ((\"hardwarePrice\" + \"installationPrice\") <= 999999999999.99)))"
    },
    {
      "name": "packages_name_not_blank",
      "table": "packages",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((length(btrim((name)::text)) > 0))"
    },
    {
      "name": "package_items_quantity_positive",
      "table": "package_items",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK (((quantity > (0)::numeric) AND (quantity <> 'NaN'::numeric)))"
    },
    {
      "name": "package_items_position_positive",
      "table": "package_items",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((\"position\" >= 1))"
    },
    {
      "name": "packages_one_active_revision",
      "table": "packages",
      "kind": "unique_partial_index",
      "owner": "D2",
      "definition": "CREATE UNIQUE INDEX packages_one_active_revision ON public.packages USING btree (\"capacityKw\", \"systemType\") WHERE active"
    },
    {
      "name": "commands_action_format",
      "table": "commands",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((action ~ '^[A-Z][A-Z0-9_]*$'::text))"
    },
    {
      "name": "commands_key_format",
      "table": "commands",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((\"idempotencyKey\" ~ '^[A-Za-z0-9_-]{8,128}$'::text))"
    },
    {
      "name": "commands_payload_hash_format",
      "table": "commands",
      "kind": "check",
      "owner": "D2",
      "definition": "CHECK ((\"payloadHash\" ~ '^[0-9a-f]{64}$'::text))"
    }
  ]
}
