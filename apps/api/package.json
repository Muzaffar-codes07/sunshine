{
  "name": "@sunshine/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test:db": "node --test test/*.db.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/serve-static": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sunshine/contracts": "*",
    "dotenv": "^17.2.3",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6"
  }
}
