# Copy to .env at the repository root. These credentials are LOCAL DEMO ONLY.
POSTGRES_USER=sunshine
POSTGRES_PASSWORD=sunshine_local_only
POSTGRES_DB=sunshine
POSTGRES_PORT=55439
DATABASE_URL=postgresql://sunshine:sunshine_local_only@127.0.0.1:55439/sunshine?schema=public
PORT=3001
# Private, repository-relative directory outside apps/web. Upload cap: 10 MiB.
UPLOAD_DIR=./var/uploads
NODE_ENV=development
# Generate a random 32-byte secret before starting the API. Never commit real values.
SESSION_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false
# Set only when using a trusted local HTTPS reverse proxy.
TRUST_PROXY=
# Explicit opt-in for the separate staff seed CLI on a disposable local database.
DEMO_DATABASE_DISPOSABLE=false
DEMO_STAFF_PASSWORD=
# Customer self-signup sends a one-time verification link. Use a real SMTP
# account for deployment; never commit credentials. The origin must be exact.
CUSTOMER_PORTAL_ORIGIN=http://127.0.0.1:3001
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=587
CUSTOMER_SMTP_USER=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM=
